<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreSources></RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="Unity.Mirror.CodeGen" HintPath="../../../Temp/bin/Debug/Unity.Mirror.CodeGen.dll" />
    <Reference Include="Mono.CecilX" HintPath="../../../Assets/Mirror/Plugins/Mono.Cecil/Mono.CecilX.dll" />
  </ItemGroup>
  <Target Name="UseProjectCompilationPipeline" BeforeTargets="ResolveAssemblyReferences">
    <XmlPeek XmlInputPath="../../../Unity.Mirror.CodeGen.csproj"
             Query="/Project/ItemGroup/Reference[@Include='Unity.CompilationPipeline.Common']/HintPath/text()">
      <Output TaskParameter="Result" ItemName="CompilationPipelinePath" />
    </XmlPeek>
    <ItemGroup>
      <Reference Include="Unity.CompilationPipeline.Common" HintPath="@(CompilationPipelinePath)" />
    </ItemGroup>
  </Target>
</Project>
